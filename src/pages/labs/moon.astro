---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LabObservationBar from '../../components/LabObservationBar.astro';
import NextExploration from '../../components/NextExploration.astro';
import '../../styles/spatial.css';
import '../../styles/moon.css';
const phasePath=(a:number)=>{const t=a*Math.PI/180,side=Math.sin(t)>=0?1:-1;const pts=[];for(let i=0;i<=40;i++){const y=-1+i/20;pts.push([18+side*Math.sqrt(Math.max(0,1-y*y))*16,18+y*16]);}for(let i=40;i>=0;i--){const y=-1+i/20;pts.push([18+side*Math.cos(t)*Math.sqrt(Math.max(0,1-y*y))*16,18+y*16]);}return pts.map((p,i)=>`${i?'L':'M'}${p[0]} ${p[1]}`).join(' ')+'Z';};
---
<SiteLayout title="月相与日月食 · 同一轮月亮，两种视角" description="拖动月球，观察真实月面光照与日地月位置。用轨道交点和实时阴影证据解释月相、日全食、日环食与月食。">
<div class="moon-lab wrap">
 <p class="breadcrumb"><a href="/spaces/cosmos/">宇宙与三体实验室</a> / 月相与日月食</p>
 <header class="moon-intro"><div><p class="kicker">日地月观测站 · 从位置到所见</p><h1>同一轮月亮，<br/><span>两种视角。</span></h1></div><p>月亮每天换一个形状，<br/>是被地球的影子遮住了吗？<small>一边移动月球，一边看地球上的天空。<br/>把月相和“食”分开，你就读懂了光与位置。</small></p></header>
 <section class="moon-observatory" aria-label="日地月双视角观测站">
  <div class="moon-station-bar"><h2>你改变位置，天空给出答案</h2><span id="moon-motion-state">手动探索</span></div>
  <div class="moon-presets" role="group" aria-label="月相与食的经典情景">{[['crescent','娥眉月'],['first','上弦月'],['full','满月，无月食'],['solar','日全食'],['annular','日环食'],['lunar','月全食']].map(([id,label])=><button data-moon-preset={id} type="button">{label}</button>)}</div>
  <div class="moon-views">
   <div class="moon-system"><div class="moon-view-heading"><span>空间里 · 为什么会这样</span><div><button data-moon-camera="perspective" type="button" hidden>立体全景</button><button data-moon-camera="top" type="button" hidden>俯看轨道</button><button data-moon-camera="close" type="button" hidden>靠近地月</button><button id="moon-view-toggle" type="button" hidden aria-pressed="false">切换二维示意</button></div></div>
    <div id="moon-spatial" class="spatial-stage" hidden></div>
    <svg id="moon-2d" viewBox="0 0 720 480" role="group" aria-label="俯看日地月轨道，拖动月球或用左右键移动"><defs><radialGradient id="moon-earth-fill"><stop stop-color="#4696c5"/><stop offset="1" stop-color="#183c62"/></radialGradient><radialGradient id="moon-sun-fill"><stop stop-color="#fff1c6"/><stop offset="1" stop-color="#ffbd66"/></radialGradient></defs><rect width="720" height="480" fill="#091b30"/><ellipse cx="290" cy="235" rx="156" ry="150" fill="none" stroke="#7593ad"/><path d="M114 235H466" stroke="#efbd69" stroke-dasharray="7 6"/><path d="M555 210H335M555 260H335" stroke="#ffc86b" opacity=".4" stroke-dasharray="7 7"/><circle cx="290" cy="235" r="36" fill="url(#moon-earth-fill)"/><circle cx="602" cy="235" r="52" fill="url(#moon-sun-fill)"/><g id="moon-orbit-handle" role="slider" tabindex="0" aria-label="沿轨道移动月球，左右键每次一度" aria-valuemin="0" aria-valuemax="360" aria-valuenow="45"><circle cx="400" cy="129" r="16" fill="#ccd5de" stroke="#f3f8fc" stroke-width="2"/></g><text x="290" y="295" fill="#93c8ef" text-anchor="middle">地球</text><text x="602" y="315" fill="#ffd387" text-anchor="middle">太阳</text><text x="28" y="440" fill="#9ab4ce" font-size="14">俯视投影：轨道倾角另由黄纬读数显示</text></svg>
    <p id="moon-system-note" class="moon-view-note">蓝线为月球轨道，金色虚线连接两个交点。拖动月球沿轨道移动；拖空白转动，滚轮或双指缩放。</p><p class="moon-scale-note">全景压缩了距离并放大月球；食的判定按实际尺寸、距离比例计算。地球金点是下方太阳盘的理想观测点。</p>
   </div>
   <aside class="moon-sky" aria-label="从地球看见的天空"><div class="moon-sky-title"><p class="kicker">地球上 · 看到了什么</p><span>黄道北向上</span></div><div class="moon-portrait"><canvas id="moon-portrait" role="img" aria-label="娥眉月，从地球看见的月面" hidden></canvas><img id="moon-static-portrait" src="/textures/astronomy/moon-lroc.jpg" alt="NASA 月面纹理，启用脚本可显示当前月相"/><span id="moon-phase-name">月面纹理参考</span><p id="moon-portrait-note">亮面由太阳照亮，普通月相不是地球的影子。</p></div><div class="moon-sun-view"><canvas id="moon-solar-disk" role="img" aria-label="理想观测点的太阳盘" hidden></canvas><div><strong id="moon-solar-status">观测点没有日食</strong><p>金点：地球朝日侧赤道点。日食是这里的局地结果，并非整颗地球都能看到。</p></div></div><p class="moon-sky-footnote">月盘按地心视角放大；太阳盘保持日月角半径比例。红色月全食为大气透射的示意近似。</p></aside>
  </div>
  <div class="moon-live-strip" aria-label="与画面同步的观测读数"><div><span>月面受光比例 k</span><strong id="moon-fraction">14.6%</strong></div><div><span>月球黄纬 β</span><strong id="moon-latitude">+3.64°</strong></div><div><span>太阳盘被遮挡</span><strong id="moon-coverage">0.0%</strong></div><div><span>地球影子与月球</span><strong id="moon-lunar-status">没有月食</strong></div></div>
  <p id="moon-event-short" class="moon-event-short">娥眉月 · 无日月食</p><p id="moon-explanation" class="moon-explanation">同一颗月球总有约一半被太阳照亮；随着位置改变，我们看见的亮面比例改变。</p>
  <div class="moon-shadow-panel"><svg id="moon-shadow-section" viewBox="0 0 420 180" role="img" aria-label="月球所在截面的地球阴影"><circle cx="210" cy="90" r="65" fill="#2b4056"/><circle cx="210" cy="90" r="36" fill="#091b30"/><circle cx="310" cy="90" r="14" fill="#bfcbd5"/></svg><div><h3>地球影子，对准月球了吗？</h3><p id="moon-shadow-note">比较月球与本影、半影的位置。这里的圆盘尺寸和距离使用同一比例。</p><small>截面中的内圈是本影，外圈是半影，浅色小圆是月球；均按实际尺寸比例。</small></div></div><div class="moon-controls"><label for="moon-phase">沿轨道的位置 <output id="moon-phase-value">45.0°</output><input id="moon-phase" type="range" min="0" max="360" step="0.1" value="45"/><small>0° 靠近日；90° 上弦；180° 满月；270° 下弦</small></label><label for="moon-node">交点方向 <output id="moon-node-value">0.0°</output><input id="moon-node" type="range" min="0" max="360" step="0.1" value="0"/><small>两个交点是月球轨道与黄道面的交线端点</small></label><label for="moon-inclination">轨道倾角 <output id="moon-inclination-value">5.145°</output><input id="moon-inclination" type="range" min="0" max="10" step="0.001" value="5.145"/><small>真实月球约 5.145°；0° 是比较用的理想共面轨道</small></label><label for="moon-distance">地月距离 <output id="moon-distance-value">60.27 R⊕</output><input id="moon-distance" type="range" min="56" max="64" step="0.01" value="60.27"/><small>R⊕ 为地球半径；靠近/远离会改变日月视大小</small></label></div>
  <div class="moon-small-steps"><span>精细对齐</span><button data-moon-step="moon-phase:-0.1" type="button">月球 −0.1°</button><button data-moon-step="moon-phase:0.1" type="button">月球 +0.1°</button><button data-moon-step="moon-node:-1" type="button">交点 −1°</button><button data-moon-step="moon-node:1" type="button">交点 +1°</button></div>
  <div class="moon-playbar"><div><button id="moon-demo-cycle" class="moon-primary" type="button">演示：一轮月相</button><button id="moon-demo-nodes" type="button">演示：满月为什么没被遮住</button><button id="moon-pause" type="button" disabled>暂停</button><button id="moon-reset" type="button">重新探索</button></div><p id="moon-demo-note">先看一轮月相，再只改变交点方向，找出月食需要的额外条件。</p></div>
 </section>
 <section class="moon-phase-ribbon" aria-label="月相快捷定位"><p class="kicker">一个朔望月，八个观察位置</p><div>{[[0,'新月'],[45,'娥眉'],[90,'上弦'],[135,'盈凸'],[180,'满月'],[225,'亏凸'],[270,'下弦'],[315,'残月']].map(([degree,name])=><button data-moon-phase={degree} type="button" aria-label={`定位到${name}`}><svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="16" fill="#243e56"/><path d={phasePath(Number(degree))} fill="#cfdae5"/></svg><span>{name}</span></button>)}</div><p>约 29.53 天是朔望月平均值；这里的“天数”是教学进度，不对应真实日历。</p></section>
 <section class="moon-evidence"><div><p class="kicker">把所见变成证据</p><h2>月相看夹角，<br/>日月食看对齐。</h2><p>月盘变圆，是我们看见更多受光面。只有新月或满月接近轨道交点时，三个天体才可能排得足够齐。</p><p id="moon-event-note">普通月相并不需要地球的影子参与。</p></div><div><dl class="moon-readouts"><div><dt>相位角 α（太阳–月球–地球）</dt><dd id="moon-phase-angle">135.1°</dd></div><div><dt>朔望月教学进度</dt><dd id="moon-day">3.69 / 29.53 天</dd></div><div><dt>日 / 月角直径（观测点）</dt><dd id="moon-angular-size">0.533° / 0.527°</dd></div><div><dt>月盘进入地球本影的面积</dt><dd id="moon-umbra-fraction">0.0%</dd></div></dl><div class="moon-equations"><p>k = (1 + cos α) / 2</p><small id="moon-phase-formula">α=135.1° → 受光比例 k≈14.6%</small><p>角半径 ρ = asin(R / d)</p><small id="moon-size-formula">日月角大小相近。月球近时可完全盖住太阳，远时可能留下亮环。</small><p>r本影 = R⊕ − s·(R☉−R⊕)/D☉</p><small id="moon-shadow-formula">满月附近，比较月盘到影轴的距离与地球本影半径；并不是每轮满月都穿过它。</small></div></div></section>
 <section class="moon-prediction"><div><p class="kicker">先猜，再看位置</p><h2>每次满月都有月食吗？</h2><p>把轨道倾角保持在真实值，让满月远离交点，然后再把交点转到太阳方向。</p></div><div><div role="group" aria-label="月食预测"><button data-moon-prediction="always" type="button" aria-pressed="false">满月就有月食</button><button data-moon-prediction="node" type="button" aria-pressed="false">还要接近交点</button></div><p id="moon-prediction-note" role="status">记下想法，再看“满月为什么没被遮住”演示。</p></div></section>
 <section class="moon-challenge"><div><p class="kicker">你来安排一次天文事件</p><h2>保持真实倾角，<br/>找到一次月全食。</h2><p>倾角保持 5.145°、距离保持 60.27 R⊕，调整月球位置和交点方向，让整个月盘进入本影。</p></div><div><button id="moon-challenge-start" class="moon-primary" type="button">准备月食挑战</button><button id="moon-challenge-check" type="button">检验我的对齐</button><p id="moon-challenge-note" role="status">从一个没有月食的满月开始。不要把轨道直接压成同一平面。</p></div></section>
 <section class="moon-reading"><article><p class="kicker">灯、球和你，就是一座天文台</p><h2>用一盏灯，<br/>亲手制造月相。</h2><ol><li>在较暗房间让一盏固定灯充当太阳，用浅色小球充当月球，自己的眼睛代表地球上的观察者。</li><li>把球举到眼睛前方，身体慢慢转动一圈。让球稍高于眼睛，避免身体的影子落到球上。观察什么时候亮面在右、什么时候在左。</li><li>背对灯时先把球举高，看到满月；再降低到头部影子里，比较普通满月和“月食”。</li></ol><p>实体活动只使用室内灯。观看真实日食必须使用合格太阳观测设备，不能直视太阳或通过普通望远镜观察。</p></article><article><h2>逼真画面，明确边界</h2><p>月面与地球表面使用 NASA 科学影像纹理；光照、相位和遮挡随同一组位置参数变化。月全食的红色来自地球大气折射、散射后透过的光，这里只作色彩近似。</p><p>模型采用圆轨道快照、平均太阳距离和可调地月距离，不包含历书、轨道偏心、自转、章动、天平动或精确大气效应；不能预报某地某时的日月食。月盘北向上、无地平线旋转。</p><p>月盘是地心放大视图；日食只在朝日侧赤道金点判断。太阳亮度按均匀圆盘近似，忽略临边昏暗；本影与半影按小角度圆锥截面估计，不把装置的压缩距离用于科学判定。</p><p class="moon-credit">素材：NASA/GSFC/ASU LROC、NASA Blue Marble。<a href="/textures/astronomy/CREDITS.md">纹理来源与署名</a></p></article></section>
 <noscript><p class="moon-noscript">启用 JavaScript 可移动日地月并观看实时月相。月相来自太阳照亮月球的一半与观察方向的关系；月食需要满月接近轨道交点，普通满月不一定进入地影。也可按上方室内灯活动验证。</p></noscript>
 <LabObservationBar stage=".moon-views" controls=".moon-controls, .moon-small-steps, .moon-playbar" readouts={[{"label": "受光比例", "id": "moon-fraction"}, {"label": "当前观测", "id": "moon-event-short"}]}/>
 <NextExploration slug="moon"/>
</div><script>import '../../scripts/exploration/moon';</script>
</SiteLayout>
