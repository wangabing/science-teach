---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LabObservationBar from '../../components/LabObservationBar.astro';
import NextExploration from '../../components/NextExploration.astro';
import '../../styles/spatial.css';
import '../../styles/balance.css';
import {solveBalance,platformPoint} from '../../lib/exploration/balance';
const initial=solveBalance({width:.6,tilt:12,loadX:0,loadY:.65,loadMass:2,bodyMass:2});
const plot=(x:number,y:number)=>{const [wx,wy]=platformPoint(x,y,12);return [400+wx*160,330-wy*160];};
const line=(points:number[][])=>points.map(([x,y],i)=>`${i?'L':'M'}${x} ${y}`).join(' ');
const corners=[[-.3,0],[.3,0],[.3,1.2],[-.3,1.2],[-.3,0]].map(([x,y])=>plot(x!,y!));
const staticLoad=plot(0,.65),staticCenter=plot(initial.cx,initial.cy),staticFoot=plot(initial.projection,0);
---
<SiteLayout title="重心与稳定 · 稳住这件展品" description="移动配重、改变支撑宽度，倾斜后松开夹持。用三维装置、二维重力线和实时力矩发现翻倒的边界。">
<div class="balance-lab wrap">
 <p class="breadcrumb"><a href="/spaces/structures/">空间与建造实验室</a> / 重心与稳定</p>
 <header class="balance-intro"><div><p class="kicker">稳定性试验场 · 让重力线说话</p><h1>稳住<span>这件展品。</span></h1></div><p>运输车倾斜了。<br/>把重物放低、放中间，还是把底座加宽？<br/><small>先试一种办法，再松开夹持，检验它能不能站住。</small></p></header>
 <section class="balance-workshop" aria-label="倾斜稳定性实验台">
  <div class="balance-bar"><h2>你来布置，重力来检验</h2><span id="balance-held" class="balance-badge">夹持预览</span></div>
  <div class="balance-presets" role="group" aria-label="对照情景">{[['default','居中站立'],['high','高处配重'],['low','低处配重'],['wide','宽底座'],['side','偏到一侧']].map(([id,label])=><button data-balance-preset={id} type="button">{label}</button>)}</div>
  <div class="balance-stage-layout"><div class="balance-stage-column">
   <div class="spatial-toolbar"><div id="balance-cameras" hidden><button data-balance-camera="perspective" type="button">立体全景</button><button data-balance-camera="front" type="button">正视剖面</button><button data-balance-camera="top" type="button">俯看支撑面</button></div><button id="balance-view-toggle" type="button" hidden aria-pressed="false">切换二维示意</button></div>
   <div id="balance-spatial" class="spatial-stage" hidden></div>
   <svg id="balance-2d" viewBox="0 0 800 480" role="group" aria-label="二维倾斜实验台，蓝色配重可拖动或用方向键移动"><rect width="800" height="480" fill="#edf5fa"/><path d={line([plot(-1,0),plot(1,0)])} stroke="#b4c9d8" stroke-width="12"/><path d={line(corners)} fill="#a4cce3" fill-opacity=".35" stroke="#52768d"/><path d={line([plot(-.3,0),plot(.3,0)])} stroke="#ce721e" stroke-width="6"/><path d={line([staticCenter,staticFoot])} stroke="#b78315" stroke-dasharray="5 5"/><g id="balance-load" role="slider" tabindex="0" aria-label="移动配重，方向键改变横向与高度" aria-valuemin="12" aria-valuemax="108" aria-valuenow="65"><rect x={staticLoad[0]!-17} y={staticLoad[1]!-17} width="34" height="34" rx="4" fill="#297cbd"/></g><circle cx={staticCenter[0]} cy={staticCenter[1]} r="8" fill="#edb832" stroke="white" stroke-width="2"/><text x={staticCenter[0]!-22} y={staticCenter[1]!+5} text-anchor="end" fill="#906414" font-size="16">G · 重心</text></svg>
   <p id="balance-view-note" class="spatial-note">拖动蓝色配重，或用滑块改变位置。金色 G 是整体重心，虚线是竖直重力线，橙线围出原支撑面。</p>
  </div><aside class="balance-gauge" aria-labelledby="balance-gauge-heading"><p class="kicker">装置旁的证据</p><h3 id="balance-gauge-heading">重力线落在哪里？</h3><svg id="balance-support" viewBox="0 0 340 130" role="img" aria-label="重力线落在支撑范围内"><rect x="70" y="47" width="200" height="22" rx="4" fill="#e1f1eb"/><path d="M70 35V85M270 35V85" stroke="#ce721e" stroke-width="3"/><circle cx="207" cy="58" r="7" fill="#edb832"/><text x="170" y="113" text-anchor="middle" fill="#526e80">绿色范围内，才有稳定余量</text></svg><strong id="balance-status">松开后能站住</strong><dl><div><dt>原姿态稳定余量 d</dt><dd id="balance-margin">16.72 cm</dd></div><div><dt>向右临界倾角</dt><dd id="balance-critical">25.64°</dd></div></dl><p id="balance-gauge-note">余量是落点到最近边缘的距离；负值表示已经越界。</p><p class="balance-model-small">这是防滑条件下的翻倒判据，尚未松开时夹持器保持姿态。</p></aside></div>
  <div class="balance-action"><button id="balance-release" class="balance-primary" type="button">松开夹持，检验</button><button id="balance-upright" type="button">扶正，保留条件</button><span id="balance-release-note" role="status">当前只预览条件，尚未释放。</span></div>
  <div class="balance-controls"><label for="balance-tilt">倾斜台面 <output id="balance-tilt-value">12.0°</output><input id="balance-tilt" type="range" min="-60" max="60" step="0.1" value="12"/><small>正角度向右下降，负角度向左下降</small></label><label for="balance-width">支撑宽度 <output id="balance-width-value">60 cm</output><input id="balance-width" type="range" min="0.3" max="1" step="0.01" value="0.6"/><small>模型深度固定为 50 cm</small></label><label for="balance-load-y">配重高度 <output id="balance-load-y-value">65 cm</output><input id="balance-load-y" type="range" min="0.12" max="1.08" step="0.01" value="0.65"/><small>架高 120 cm，蓝色配重可上下拖动</small></label><label for="balance-load-x">配重横向位置 <output id="balance-load-x-value">0 cm</output><input id="balance-load-x" type="range" min="-0.24" max="0.24" step="0.01" value="0"/><small>向左为负，向右为正；收窄时限制在架内</small></label><label for="balance-mass">配重质量 <output id="balance-mass-value">2.0 kg</output><input id="balance-mass" type="range" min="0.5" max="5" step="0.1" value="2"/><small>均匀架质量固定为 2 kg</small></label></div>
  <div class="balance-fine"><span>小步调整</span><button data-balance-step="balance-load-y:-0.01" type="button">配重降低 1 cm</button><button data-balance-step="balance-load-y:0.01" type="button">配重升高 1 cm</button><button data-balance-step="balance-tilt:-1" type="button">倾角 −1°</button><button data-balance-step="balance-tilt:1" type="button">倾角 +1°</button></div>
  <div class="balance-demo"><div><button id="balance-demo-tip" type="button">演示：越过边缘会怎样</button><button id="balance-demo-low" type="button">演示：把配重放低</button><button id="balance-pause" type="button" disabled>暂停</button><button id="balance-reset" type="button">重新探索</button></div><p id="balance-demo-note" aria-live="off">先把台面慢慢倾斜，看看金色落点何时走出支撑面。</p></div>
 </section>
 <section class="balance-motion" aria-label="释放后的实时运动"><div><p class="kicker">释放后，观察变化</p><h2>站住，还是绕边缘翻倒？</h2><p id="balance-motion-note">松开后才开始运动。下方静态判据对应释放前的条件。</p></div><dl><div><dt>释放后时间</dt><dd id="balance-time">0.00 s</dd></div><div><dt>相对台面转角</dt><dd id="balance-angle">0.0°</dd></div><div><dt>角速度</dt><dd id="balance-speed">0.0°/s</dd></div></dl></section>
 <section class="balance-evidence" aria-labelledby="balance-evidence-heading"><div><p class="kicker">公式解释刚才的变化</p><h2 id="balance-evidence-heading">重量的位置，<br/>比“有多重”更关键。</h2><p id="balance-conclusion">总重心由架与配重共同决定。重力线落在支撑面内，才有恢复方向的力矩。</p></div><div><dl class="balance-readouts"><div><dt>整体重心 xG / yG</dt><dd id="balance-center">0.0 / 62.5 cm</dd></div><div><dt>原姿态重力线落点 q</dt><dd id="balance-projection">13.3 cm</dd></div><div><dt>最近边缘恢复力矩</dt><dd id="balance-moment">6.42 N·m</dd></div><div><dt>向左 / 向右临界倾角</dt><dd id="balance-both-critical">25.6° / 25.6°</dd></div></dl><div class="balance-equations"><p>xG = m·x / (M+m)<br/>yG = (M·h/2 + m·y) / (M+m)</p><small id="balance-center-formula">M=2 kg，m=2 kg；xG=0，yG=0.625 m</small><p>q = xG + yG·tanθ<br/>d = b/2 − |q|</p><small id="balance-support-formula">q=0+0.625·tan12°，d=0.3−|q|</small><p>τ = (M+m)·g·cosθ·d</p><small id="balance-moment-formula">g=9.81 m/s²；正值为恢复方向，负值为翻倒方向</small></div></div></section>
 <section class="balance-prediction"><div><p class="kicker">先说出你的想法</p><h2>同样重，放在哪里更稳？</h2><p>保持支撑宽度、配重质量和倾角不变，只移动配重高度。</p></div><div><div role="group" aria-label="重心预测"><button data-balance-prediction="low" type="button" aria-pressed="false">放低更稳</button><button data-balance-prediction="high" type="button" aria-pressed="false">放高更稳</button><button data-balance-prediction="same" type="button" aria-pressed="false">一样重，所以一样稳</button></div><p id="balance-prediction-note" role="status">选一个想法，再点“把配重放低”演示，用临界角和余量检验。</p></div></section>
 <section class="balance-challenge"><div><p class="kicker">把发现变成设计</p><h2>让展品通过<br/>20° 运输斜坡。</h2><p>松开夹持前，给它留出至少 3 cm 的稳定余量。你可以移动配重、改变质量或加宽支撑；倾角必须保持 20°。</p></div><div><button id="balance-challenge-start" class="balance-primary" type="button">准备运输挑战</button><button id="balance-challenge-check" type="button">检验我的方案</button><p id="balance-challenge-note" role="status">准备后会给你一件容易翻倒的展品。试着只改变一个条件。</p></div></section>
 <section class="balance-reading"><article><p class="kicker">从实验台走向生活</p><h2>纸盒和几枚硬币，<br/>也能验证你的设计。</h2><ol><li>用小纸盒固定几枚硬币，先放在上方、再放在底部。保持硬币数量相同。</li><li>在防滑板上慢慢抬高一端，观察何时开始翻倒。板边加挡条防止先滑动，安排柔软接落处。</li><li>再把硬币移向一侧，比较左倾与右倾。一次只改一个条件，记录临界倾角。</li></ol><p>运输车把货物放低、不倒翁把配重放低，背后都有重心与支撑的关系。想一想：只把一件形状不变的展品所有质量同时加倍，会不会改变临界角？</p></article><article><h2>这个模型的边界</h2><p>模型是按均匀矩形刚体近似的架与固定点配重，高 1.2 m，深 0.5 m；所有距离按 SI 单位计算，读数常换成 cm。图案不是具体实物的测量。</p><p>只沿左右方向倾斜，支点不滑动且摩擦足够。失稳后绕边缘受重力转动，首次侧面接触台面就停止，不模拟滑动、碰撞反弹或材料变形。实际装置可能先滑动。</p><p>夹持预览可以保持失稳姿态；释放前公式是原姿态的判据。翻倒或落地后不能把原支撑面当成新的接触面。恰好在边缘是临界平衡，微小扰动会影响结果。</p></article></section>
 <noscript><p class="balance-noscript">启用 JavaScript 可移动配重、倾斜和释放。静态条件：架 2 kg、配重 2 kg、高度 65 cm、支撑宽度 60 cm，整体重心高 62.5 cm，向右临界倾角约 25.6°。当前 12° 倾斜仍稳定。也可按上方纸盒活动动手验证。</p></noscript>
 <LabObservationBar stage=".balance-stage-layout" controls=".balance-controls, .balance-fine, .balance-demo" readouts={[{"label": "稳定余量", "id": "balance-margin"}, {"label": "松开后的判定", "id": "balance-status"}]}/>
 <NextExploration slug="balance"/>
</div><script>import '../../scripts/exploration/balance';</script>
</SiteLayout>
