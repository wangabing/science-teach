---
import ExperimentHistory from '../../components/ExperimentHistory.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import LabObservationBar from '../../components/LabObservationBar.astro';
import NextExploration from '../../components/NextExploration.astro';
import '../../styles/spatial.css';
import '../../styles/mobius.css';
---
<SiteLayout title="莫比乌斯带 · 一张纸的另一面，去哪了？" description="转动三维纸带，沿面与沿边追踪，预测中心剪切结果，再用一张纸验证单面的秘密。">
<div class="paper-lab wrap">
 <p class="breadcrumb"><a href="/spaces/geometry/">数学与几何实验室</a> / 莫比乌斯带</p>
 <header class="paper-intro"><div><p class="kicker">纸带研究所 · 一次扭转，改变规则</p><h1>另一面，<br/><span>去哪了？</span></h1></div><div><p>一张纸有两面。<br/>接成一个环以后，还一定如此吗？</p><p>让金色标记替你走一走。无需翻过纸边，能不能走遍你以为的“正反两面”？</p></div></header>
    <ExperimentHistory slug="mobius" />
 <section class="paper-workshop" aria-label="纸带工作台">
  <div class="paper-heading"><div><p class="kicker">先接一条纸带</p><h2>扭一扭，再出发</h2></div><span>TOPOLOGY / PAPER</span></div>
  <div class="paper-types" role="group" aria-label="选择半扭转次数">{[['0','普通纸环','不扭转'],['1','莫比乌斯带','扭转 180°'],['2','双半扭转带','扭转 360°']].map(([n,title,note])=><button data-paper-twists={n} type="button" aria-pressed={n==='1'?'true':'false'}><strong>{title}</strong><small>{note}</small></button>)}</div>
  <div class="spatial-toolbar"><div id="paper-camera-controls" hidden><button data-paper-camera="perspective" type="button">立体全景</button><button data-paper-camera="top" type="button">从上方看</button><button data-paper-camera="front" type="button">从侧面看</button></div><button id="paper-view-toggle" type="button" hidden aria-pressed="false">切换二维示意</button></div>
  <div id="paper-spatial" class="spatial-stage" hidden></div>
  <svg id="paper-fallback" viewBox="0 0 800 440" role="img" aria-label="莫比乌斯带空间投影，金色标记从接缝出发"><rect width="800" height="440" fill="#eaf5f3"/><path d="M220 160C500 45 690 230 490 340C240 410 70 180 330 135C570 90 620 370 310 315C100 270 200 120 220 160Z" stroke="#397f73" fill="#93d6c7" stroke-width="3"/><circle cx="600" cy="200" r="10" fill="#e79d19"/></svg>
  <div class="paper-cut-scrub"><label for="paper-cut-progress">中线剪切进度 <output id="paper-cut-progress-value">0%</output><input id="paper-cut-progress" type="range" min="0" max="100" step="1" value="0"/></label><p id="paper-cut-stage-note" aria-live="off">还没有剪开。先预测，再推进切缝；也可直接手动观察。</p></div>
  <p id="paper-view-note" class="spatial-note">金色标记是行走者，白线是接缝。三维装置可拖动空白旋转，也可用方向键与视角按钮。</p>
  <div class="paper-trace-controls"><div id="paper-components" role="group" aria-label="选择剪后的完整纸带" hidden><button data-paper-component="0" type="button" aria-pressed="true">第 1 条带</button><button data-paper-component="1" type="button" aria-pressed="false">第 2 条带</button></div><div role="group" aria-label="追踪路径"><button id="paper-surface" type="button" aria-pressed="true">沿纸面走</button><button id="paper-edge" type="button" aria-pressed="false">沿纸边走</button><button id="paper-new-edge" type="button" aria-pressed="false" hidden>沿新切边走</button></div><div><button id="paper-demo" class="paper-primary" type="button">演示：走到起点</button><button id="paper-pause" type="button" disabled>暂停追踪</button><button id="paper-reset" type="button">重新探索</button></div><label for="paper-progress">手动定位 <output id="paper-progress-value">0%</output><input id="paper-progress" type="range" min="0" max="100" step="1" value="0"/></label><p id="paper-trace-note" aria-live="off">从接缝出发，先走一圈看看。莫比乌斯带要绕两圈才回到出发位置。</p></div>
 </section>
 <section class="paper-evidence" aria-labelledby="paper-evidence-heading"><div><p class="kicker">看见连续性，再给它命名</p><h2 id="paper-evidence-heading">换个方向，<br/>仍然是同一张纸。</h2><p id="paper-conclusion">一次半扭转：纸面连续，边界也连续。沿着走，比凭颜色判断更可靠。</p></div><div><dl><div><dt>半扭转次数 n</dt><dd id="paper-twists-value">1</dd></div><div><dt id="paper-sides-label">纸面数</dt><dd id="paper-sides">1</dd></div><div><dt id="paper-boundaries-label">边界条数</dt><dd id="paper-boundaries">1</dd></div><div><dt>已绕中心</dt><dd id="paper-circuits">0.00 圈</dd></div></dl><p class="paper-formula">P(2π, v) = P(0, (−1)ⁿv)</p><p id="paper-seam">n 为奇数：接缝把局部宽度坐标 v 接到 −v，因此走一圈换到另一侧，两圈回到原处。</p><p class="paper-model-note">v 是纸带横向位置，t 是绕中心的角度。这里的“圈”指绕中心，不是计量长度；面数、边数是连接关系，不是颜色块数。</p></div></section>
 <section class="paper-cut" aria-labelledby="paper-cut-heading"><div><p class="kicker">先预测，再动剪刀</p><h2 id="paper-cut-heading">沿中线剪开，<br/>会得到几条带？</h2><p>沿整条纸带的中央剪一圈。先记下想法，再一点点推进切缝，看看哪里还连着。</p></div><div><div class="paper-prediction" role="group" aria-label="中心剪切预测"><button data-paper-predict="1" type="button" aria-pressed="false">仍是一条带</button><button data-paper-predict="2" type="button" aria-pressed="false">变成两条带</button></div><p id="paper-prediction-note" role="status">选择预测，再点“沿中线剪开”。</p><button id="paper-cut" class="paper-primary" type="button">沿中线剪开</button><button id="paper-cut-pause" type="button" disabled>暂停剪切</button><button id="paper-restore" type="button" disabled>恢复未剪纸带</button><p id="paper-cut-result" role="status">结果会显示在上方工作台；你仍可以转动纸带，看清连接处。</p><p class="paper-model-note">红色标记是当前剪切位置。画面扩大切缝，便于辨认连接；没有模拟真实纸张拉伸。半扭转次数切换会重新接一条纸带。</p></div></section>
 <section class="paper-at-home"><div><p class="kicker">屏幕之外，也有实验室</p><h2>用一张纸，<br/>把发现带到手上。</h2></div><ol><li><strong>准备三张长纸条</strong><p>各约 30 × 3 cm，备胶带、笔与剪刀。使用剪刀时请按年龄寻求成人协助。</p></li><li><strong>接出三种纸带</strong><p>第一条不扭，第二条扭 180°，第三条扭 360°，分别首尾粘合。</p></li><li><strong>沿面画线，沿边走一遍</strong><p>保持笔不跨过纸边。观察什么时候回到起点，比较纸面与边界的连接。</p></li><li><strong>沿中线剪开，比较结果</strong><p>先预测每一种的条数。剪后数的是完整相连的纸带；转动双半扭转的两条带，看看能否分开。</p></li></ol></section>
 <section class="paper-reading"><h2>为什么这不是一个“反常识把戏”？</h2><p>拓扑关心连接关系。普通纸环可以连续区分正反面；莫比乌斯带在接缝处把这两种局部称呼交换了，因此无法在整条带上一直保持“正面”的命名。走一走就能验证，不必记一个神奇答案。</p><p>沿中心剪开莫比乌斯带后，留下的是一条更长的双面带。双半扭转带剪后有两条，而且相互套连。可以比较零、一、两次半扭转：哪些性质取决于奇偶，哪些取决于完整扭转？</p><p>纸带参数曲面是平滑的理想模型。这里不把已粘好的环连续变成另一种拓扑，每次选择都相当于重新制作。二维图是同一曲面的投影，重叠处需用三维或实体纸条判断。</p></section>
 <noscript><p class="paper-noscript">启用 JavaScript 可转动、追踪与剪开。静态情景为一次半扭转的莫比乌斯带：一面、一条边，中心剪开仍是一条双面带。你也可以直接按上面的步骤制作纸带。</p></noscript>
 <LabObservationBar stage="#paper-spatial, #paper-fallback" controls=".paper-trace-controls, .paper-cut" readouts={[{"label": "绕中心", "id": "paper-circuits"}, {"label": "边界数", "id": "paper-boundaries"}]}/>
 <NextExploration slug="mobius"/>
</div><script>import '../../scripts/exploration/mobius';</script>
</SiteLayout>
