---
import {trails,trailExperiment} from '../data/trails';
const {slug}=Astro.props;
const options=trails.filter(t=>t.steps.some(s=>s.slug===slug));
---
{options.length>0&&<aside class="next-exploration" aria-label="下一次探索"><div><p class="kicker">带着证据，接着问</p><h2>下一题，为什么值得试？</h2><div class="route-options">{options.map(trail=>{
 const index=trail.steps.findIndex(s=>s.slug===slug),next=trail.steps[index+1];
 return <div class="route-option" data-next-route={trail.id}><strong>{trail.title}</strong><p>{next?next.observe:'这条路线走到这里。回看各装置的共同关系，也可以选择另一条路线。'}</p><a class="text-link" href={next?`${trailExperiment(next.slug).href}?trail=${trail.id}`:`/experiments/#trail-${trail.id}`}>{next?`继续探索：${trailExperiment(next.slug).name} ↗`:'回看这条路线 ↗'}</a></div>;
 })}</div><button type="button" data-all-routes hidden>看看其他相关路线</button></div></aside>}
<script>
 const route=new URL(location.href).searchParams.get('trail');
 const options=[...document.querySelectorAll<HTMLElement>('[data-next-route]')];
 if(route&&options.some(el=>el.dataset.nextRoute===route)){
  options.forEach(el=>el.hidden=el.dataset.nextRoute!==route);
  const button=document.querySelector<HTMLButtonElement>('[data-all-routes]');
  if(button&&options.length>1){button.hidden=false;button.addEventListener('click',()=>{options.forEach(el=>el.hidden=false);button.hidden=true;});}
 }
</script>
