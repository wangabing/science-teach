---
interface Props {stage:string;controls:string;readouts:{label:string;id:string}[]}
const {stage,controls,readouts}=Astro.props;
---
<div class="lab-observation-bar" data-stage={stage} data-controls={controls} aria-label="调整时的实时观察" hidden>
 <div class="observation-values">{readouts.map(r=><div><span>{r.label}</span><strong data-observe-id={r.id}></strong></div>)}</div><button type="button" data-return-stage>回看画面 ↑</button>
</div>
<style>
.lab-observation-bar{display:none}.observation-values{display:grid;grid-template-columns:1fr 1fr;gap:14px;min-width:0;flex:1}.observation-values span{display:block;font-size:9px;line-height:1.8;color:#537188}.observation-values strong{display:block;font-size:12px;line-height:1.8;color:#183b53;overflow-wrap:anywhere}.lab-observation-bar button{font:inherit;font-size:11px;white-space:nowrap;border:1px solid #c1d7e5;border-radius:6px;color:#246b9e;background:#edf6fc;padding:10px!important;align-self:center}.lab-observation-bar button:focus-visible{outline:3px solid #df9e36;outline-offset:3px}
@media(max-width:700px){.lab-observation-bar:not([hidden]){position:fixed;z-index:20;bottom:0;left:0;right:0;display:flex;gap:14px;align-items:center;padding:12px max(16px,env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left));background:#f8fcff;border-top:1px solid #b8d0df;box-shadow:0 -5px 20px #17374d14}:global(.observation-controls){padding-bottom:100px!important}}
</style>
<script>
for(const bar of document.querySelectorAll<HTMLElement>('.lab-observation-bar')){
 const stages=[...document.querySelectorAll<HTMLElement>(bar.dataset.stage!)],controls=[...document.querySelectorAll<HTMLElement>(bar.dataset.controls!)];
 controls.at(-1)?.classList.add('observation-controls');
 const visible=(n:HTMLElement)=>{const r=n.getBoundingClientRect();return r.width>0&&r.height>0&&Math.min(r.bottom,innerHeight)-Math.max(r.top,0)>12;};
 const refresh=()=>bar.hidden=!matchMedia('(max-width:700px)').matches||stages.some(visible)||!controls.some(visible);
 const watch=new MutationObserver(()=>{for(const target of bar.querySelectorAll<HTMLElement>('[data-observe-id]'))target.textContent=document.getElementById(target.dataset.observeId!)?.textContent??'';});
 for(const target of bar.querySelectorAll<HTMLElement>('[data-observe-id]')){const source=document.getElementById(target.dataset.observeId!);target.textContent=source?.textContent??'';if(source)watch.observe(source,{childList:true,subtree:true,characterData:true});}
 const observer=new IntersectionObserver(refresh);[...stages,...controls].forEach(n=>observer.observe(n));window.addEventListener('scroll',refresh,{passive:true});window.addEventListener('resize',refresh);window.addEventListener('pageshow',refresh);
 bar.querySelector('button')!.addEventListener('click',()=>{const stage=stages.find(n=>n.getBoundingClientRect().height>0);stage?.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'});});refresh();
}
</script>
