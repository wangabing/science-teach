---
interface Props { kind: string }
const { kind } = Astro.props;
---
<svg viewBox="0 0 360 200" fill="none" aria-hidden="true" class="instrument">
  {kind === 'moon' && <><ellipse cx="156" cy="100" rx="95" ry="64" stroke="currentColor" stroke-width="1.5" opacity=".6"/><circle cx="156" cy="100" r="24" fill="currentColor"/><circle cx="230" cy="61" r="13" fill="#c6d0dc"/><path d="M230 48A13 13 0 0 1 230 74A8 13 0 0 0 230 48" fill="#edf5fc"/><circle cx="312" cy="100" r="27" fill="#ffc86b"/><path d="M274 82H202M274 117H202" stroke="#dba545" stroke-dasharray="5 5"/></>}
  {kind === 'balance' && <><g transform="rotate(12 180 160)"><path d="M65 160H300" stroke="currentColor" stroke-width="6" opacity=".3"/><rect x="130" y="32" width="100" height="128" fill="currentColor" opacity=".1" stroke="currentColor" stroke-width="2"/><path d="M130 160H230" stroke="#ce721e" stroke-width="5"/><rect x="185" y="64" width="25" height="25" rx="3" fill="currentColor"/></g><circle cx="194" cy="105" r="7" fill="#edb832"/><path d="M194 105V172" stroke="#b78315" stroke-width="2" stroke-dasharray="4 4"/></>}
  {kind === 'mobius'  && <><path d="M70 95C120 18 292 54 285 117C270 183 86 177 73 113C60 54 226 15 252 91C270 170 100 183 70 95Z" fill="currentColor" opacity=".24" stroke="currentColor" stroke-width="3"/><path d="M81 102C110 50 260 54 270 115C250 165 103 149 96 100" stroke="currentColor" stroke-width="2"/><circle cx="96" cy="100" r="7" fill="#e5ac27"/></>}
  {kind === 'lens'  && <><path d="M35 112H325" stroke="currentColor" opacity=".25"/><path d="M170 30Q150 112 170 174Q190 112 170 30Z" fill="currentColor" opacity=".2" stroke="currentColor" stroke-width="2"/><path d="M62 112V62m-7 10l7 -10 7 10" stroke="#c58b16" stroke-width="4"/><path d="M62 62H170L270 137M62 62L270 137" stroke="currentColor" stroke-width="2"/><path d="M270 50V168M270 112V137m-6 -8l6 8 6 -8" stroke="#7560ad" stroke-width="3"/><circle cx="237" cy="112" r="4" fill="currentColor"/></>}
  {kind === 'area' && <><rect x="76" y="25" width="150" height="150" fill="#ffdc61" opacity=".5"/><path d="M76 25H140L76 111ZM226 25V89L140 25ZM226 175H162L226 89ZM76 175V111L162 175Z" fill="currentColor" opacity=".8"/><path d="M76 25H226V175H76ZM140 25L226 89L162 175L76 111Z" stroke="currentColor" stroke-width="2"/><path d="M250 80L278 100L250 120M238 100H278" stroke="currentColor" stroke-width="3"/></>}
  {kind === 'sections' && <><path d="M180 20L265 65V145L180 185L95 145V65Z" fill="currentColor" opacity=".06"/><path d="M180 20L265 65V145L180 185L95 145V65ZM95 65L180 110L265 65M180 110V185" stroke="currentColor" stroke-width="2"/><path d="M137 43L223 43L265 106L222 165L137 165L95 106Z" fill="currentColor" opacity=".3" stroke="currentColor" stroke-width="2"/></>}
  {kind === 'three-body' && <><path d="M84 100C84 22 269 179 269 100C269 21 84 179 84 100Z" stroke="currentColor" stroke-width="2"/><path d="M89 100C89 15 279 185 279 100C279 16 89 185 89 100Z" stroke="currentColor" opacity=".35" stroke-dasharray="5 5"/><circle cx="101" cy="78" r="14" fill="currentColor"/><circle cx="251" cy="122" r="14" fill="currentColor" opacity=".65"/><circle cx="180" cy="100" r="14" fill="currentColor" opacity=".4"/></>}
  {kind === 'bridge' && <><path d="M58 158H302M80 146H280M80 66H280M80 66V146M180 66V146M280 66V146M80 146L180 66L280 146" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>{[80,180,280].map(x=><><circle cx={x} cy="66" r="6" fill="currentColor"/><circle cx={x} cy="146" r="6" fill="currentColor"/></>)}<path d="M180 20V48M172 40L180 48L188 40" stroke="currentColor" stroke-width="2"/></>}
  {kind === 'gears' && <><circle cx="126" cy="100" r="40" fill="currentColor" opacity=".16" stroke="currentColor" stroke-width="10" stroke-dasharray="9 6"/><circle cx="227" cy="100" r="62" fill="currentColor" opacity=".25" stroke="currentColor" stroke-width="12" stroke-dasharray="10 7"/><path d="M126 100L155 100M227 100L227 54" stroke="currentColor" stroke-width="3"/><circle cx="126" cy="100" r="8" fill="currentColor"/><circle cx="227" cy="100" r="12" fill="currentColor"/></>}
  {kind === 'pendulum' && <><ellipse cx="180" cy="177" rx="118" ry="13" fill="currentColor" opacity=".08"/><path d="M80 170V32H245M65 170H112" stroke="currentColor" stroke-width="8" stroke-linecap="round"/><path d="M214 35L265 130" stroke="currentColor" stroke-width="2"/><path d="M150 140Q210 183 273 138" stroke="currentColor" stroke-dasharray="4 7" opacity=".4"/><circle cx="265" cy="130" r="22" fill="currentColor"/><circle cx="259" cy="123" r="6" fill="white" opacity=".7"/><circle cx="214" cy="35" r="5" fill="currentColor"/></>}
  {kind === 'geometry' && <><path d="M180 24L257 65V143L180 184L103 143V65Z" fill="currentColor" opacity=".08"/><path d="M180 24L257 65V143L180 184L103 143V65ZM103 65L180 108L257 65M180 108V184M180 24V108M103 143L180 108L257 143" stroke="currentColor" stroke-width="2"/><circle cx="180" cy="108" r="7" fill="currentColor"/><path d="M80 179H280" stroke="currentColor" opacity=".15"/></>}
  {kind === 'orbit' && <><ellipse cx="180" cy="102" rx="122" ry="51" transform="rotate(-20 180 102)" stroke="currentColor" stroke-width="1.5"/><ellipse cx="180" cy="102" rx="105" ry="61" transform="rotate(30 180 102)" stroke="currentColor" stroke-dasharray="5 5" opacity=".5"/><circle cx="174" cy="104" r="23" fill="currentColor"/><circle cx="277" cy="66" r="13" fill="currentColor" opacity=".65"/><circle cx="112" cy="137" r="9" fill="currentColor" opacity=".35"/><path d="M174 73V57M143 104H127M174 135V151M205 104H221" stroke="currentColor" opacity=".3"/></>}
  {kind === 'structure' && <><path d="M63 151H297M83 151L122 62L162 151L201 62L241 151L280 62M83 151H280V62H122M122 62L201 62M162 151L201 62" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><path d="M63 161H297" stroke="currentColor" opacity=".25"/>{[83,162,241,280].map(x=><circle cx={x} cy="151" r="6" fill="currentColor"/>)}<path d="M178 27V49M171 42L178 49L185 42" stroke="currentColor" stroke-width="2"/></>}
  {kind === 'buoyancy' && <><path d="M90 171V24H188V57M70 174H114" stroke="currentColor" stroke-width="7" stroke-linecap="round"/><rect x="177" y="57" width="22" height="38" rx="5" fill="white" stroke="currentColor" stroke-width="2"/><path d="M188 95V121" stroke="currentColor" stroke-width="2"/><path d="M135 99V175H279V99" stroke="currentColor" stroke-width="2"/><path d="M135 129H279V175H135Z" fill="currentColor" opacity=".15"/><path d="M135 129H279" stroke="currentColor"/><rect x="172" y="118" width="32" height="40" fill="currentColor" opacity=".6"/><path d="M242 148V112M235 120L242 112L249 120" stroke="currentColor" stroke-width="2"/></>}
</svg>
